# ----------------------------------------
# Production environment variables template
# Target platforms: Vercel + Neon
# ----------------------------------------

# Neon PostgreSQL
# Use the pooled Neon URL for app runtime queries.
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=verify-full&pgbouncer=true"

# Optional but recommended for migrations:
# Use Neon direct connection (non-pooled) for migrations.
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<database>?sslmode=verify-full"

# NextAuth
# Example: https://zigzag.vercel.app
NEXTAUTH_URL="https://<your-project>.vercel.app"
NEXTAUTH_SECRET="<generate-with-openssl-rand-base64-32>"

# Vercel Blob — company logo uploads (and related Blob puts).
# Create a PUBLIC Blob store in Vercel Storage, link it to this project, and set
# the store's BLOB_READ_WRITE_TOKEN. Private stores reject public logo uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<from-public-blob-store>"

# Cron — Authorization: Bearer <CRON_SECRET> for /api/cron/notifications
# (schedule configured in vercel.json).
CRON_SECRET="<generate-with-openssl-rand-base64-32>"

# Runtime
NODE_ENV="production"

# Optional observability / analytics — see .env.example
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
