{
  "buildCommand": "npm run vercel-build",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "sandbox": false
    }
  },
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi'",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 13 * * *"
    }
  ]
}
